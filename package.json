{
  "name": "@synapsestudios/lintofu",
  "version": "0.9.0",
  "description": "ESLint plugin for linting OpenTofu configurations",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/synapsestudios/lintofu.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "scripts": {
    "build:wasm": "bash scripts/build-wasm.sh",
    "build:js": "tsc",
    "build:assets": "mkdir -p dist/parser && cp src/parser/wasm-exec.cjs src/parser/lintofu-parser.wasm dist/parser/",
    "build": "npm run build:wasm && npm run build:js && npm run build:assets",
    "pretest": "npm run build:wasm",
    "test": "vitest run",
    "test:ci": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint \"src/**/*.ts\" \"scripts/**/*.ts\" --fix",
    "lint:ci": "eslint \"src/**/*.ts\" \"scripts/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"scripts/**/*.{mjs,ts}\" \"vitest.config.ts\" \"docs/.vitepress/**/*.mts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"scripts/**/*.{mjs,ts}\" \"vitest.config.ts\" \"docs/.vitepress/**/*.mts\"",
    "docs:versions": "node scripts/render-tested-versions.mjs",
    "docs:versions:check": "node scripts/render-tested-versions.mjs --check",
    "docs:rules": "tsx scripts/render-rule-index.ts",
    "docs:rules:check": "tsx scripts/render-rule-index.ts --check",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "clean": "rm -rf dist",
    "prepare": "lefthook install || true",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "eslint": "^9.0.0 || ^10.0.0"
  },
  "dependencies": {
    "@eslint/core": "^1.2.1",
    "@eslint/plugin-kit": "^0.7.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-eslint-plugin": "^7.6.2",
    "eslint-plugin-jsdoc": "^65.3.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-security": "^4.2.0",
    "eslint-plugin-tsdoc": "^0.5.4",
    "globals": "^17.13.0",
    "lefthook": "^2.2.2",
    "prettier": "^3.9.10",
    "prettier-plugin-organize-imports": "^4.3.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.4"
  },
  "keywords": [
    "eslint",
    "eslint-plugin",
    "eslintplugin",
    "opentofu",
    "terraform",
    "hcl",
    "linting"
  ]
}
