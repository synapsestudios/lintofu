{
  "name": "lintofu",
  "version": "0.0.0",
  "description": "ESLint plugin for linting OpenTofu configurations",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "scripts": {
    "build:wasm": "bash scripts/build-wasm.sh",
    "build:js": "tsc",
    "build:assets": "mkdir -p dist/parser && cp src/parser/wasm-exec.cjs src/parser/lintofu-parser.wasm dist/parser/",
    "build": "npm run build:wasm && npm run build:js && npm run build:assets",
    "pretest": "npm run build:wasm",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "lint:ci": "eslint \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "clean": "rm -rf dist",
    "prepare": "lefthook install || true",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "eslint": "^9.0.0 || ^10.0.0"
  },
  "dependencies": {
    "@eslint/core": "^1.2.1",
    "@eslint/plugin-kit": "^0.7.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.6.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-eslint-plugin": "^7.3.2",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-security": "^4.0.0",
    "globals": "^17.5.0",
    "lefthook": "^2.1.6",
    "prettier": "^3.8.3",
    "prettier-plugin-organize-imports": "^4.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.1",
    "vitest": "^4.1.5"
  },
  "keywords": [
    "eslint",
    "eslint-plugin",
    "eslintplugin",
    "opentofu",
    "terraform",
    "hcl",
    "linting"
  ]
}
